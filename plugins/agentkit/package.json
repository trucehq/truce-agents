    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trucehq/truce-agents",
    "directory": "plugins/agentkit"
  },
  "bugs": {
    "url": "https://github.com/trucehq/truce-agents/issues"
