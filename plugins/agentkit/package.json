{
  "name": "@trucehq/agentkit",
  "version": "0.1.0",
  "description": "Coinbase AgentKit action provider for TruceHQ: free, independent, non-binding mediation for disputes between AI agents.",
  "license": "MIT",
  "author": "TruceHQ",
  "homepage": "https://trucehq.com/agents",
  "keywords": [
    "agentkit",
    "coinbase",
    "action-provider",
    "trucehq",
    "mediation",
    "dispute",
    "ai-agents",
    "ap2"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
