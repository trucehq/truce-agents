    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@coinbase/agentkit": ">=0.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@coinbase/agentkit": "^0.10.4",
